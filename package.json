{
  "name": "@jqson/jqson",
  "version": "1.0.0",
  "description": "jQuery for JSON：CSS 选择器查询、链式修改、事务回滚、变更流、fork/merge 并行。浏览器和 Node 通用，零依赖。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./worker": "./src/worker.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "jqson": "bin/jqson.js"
  },
  "files": [
    "src",
    "bin",
    "types/index.d.ts",
    "examples",
    "skills",
    "docs",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser/run.mjs",
    "typecheck": "tsc -p types/tsconfig.json",
    "bench": "node bench/bench.js",
    "test:bundlers": "node test/bundlers/run.mjs"
  },
  "license": "MIT",
  "keywords": [
    "json",
    "css-selector",
    "dom",
    "jquery",
    "patch",
    "agent",
    "parallel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youngdro/jqson.git"
  },
  "homepage": "https://github.com/youngdro/jqson#readme",
  "bugs": {
    "url": "https://github.com/youngdro/jqson/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./types/index.d.ts",
  "devDependencies": {
    "playwright": "1.49.1",
    "typescript": "5.6.3"
  }
}
